{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "../dist",
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "react",
    "esModuleInterop": true,
    "target": "es2021",
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules"]
}
